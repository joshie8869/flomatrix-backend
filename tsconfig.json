{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "moduleResolution": "Bundler",
    "baseUrl": "./",
    "paths": {
      "@core/*": ["src/core/*"],
      "@render/*": ["src/render/*"],
      "@utils/*": ["src/utils/*"],
      "@shaders/*": ["src/shaders/*"],
      "@types/*": ["src/types/*"]
    }
  },
  "include": ["src/**/*"]
}
